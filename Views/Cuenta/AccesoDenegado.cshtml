@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="bg-white border rounded-4 p-5 shadow-sm">
                <div style="width: 80px; height: 80px; background: #fee2e2; color: #dc2626; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 2.5rem; margin-bottom: 24px;">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <h2 class="fw-bold text-dark mb-2">Acceso Restringido</h2>
                <p class="text-secondary mb-4">
                    Tu rol actual no dispone de los permisos necesarios para realizar esta acción.
                    Solo los usuarios con rol de <strong>Organización</strong> o <strong>Administrador</strong> pueden crear campañas o validar horas.
                </p>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Voluntariado" asp-action="Index" class="btn btn-eco-primary">
                        <i class="fa-solid fa-house me-1"></i> Ir al Inicio
                    </a>
                    <a asp-controller="Cuenta" asp-action="Login" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Cambiar de Cuenta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
