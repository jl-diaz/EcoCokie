@{
    ViewData["Title"] = "Inscripción Confirmada";
    var proyecto = ViewBag.Proyecto as VoluntariadoAmbiental.Models.Proyecto;
    var carnet = ViewBag.Carnet as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="bg-white border rounded-3 p-4 p-md-5 text-center shadow-sm">
                <div style="width: 68px; height: 68px; background: #ecfdf5; color: #15803d; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 20px;">
                    <i class="fa-solid fa-check"></i>
                </div>

                <h3 class="fw-bold text-dark mb-2">¡Inscripción Confirmada!</h3>
                <p class="text-muted small mb-4">
                    Tu postulación ha sido registrada formalmente en el sistema. Presenta tu carnet estudiantil al llegar al Punto Verde.
                </p>

                <!-- Comprobante Digital -->
                <div class="p-4 rounded-3 text-start mb-4 border" style="background: #f8fafc;">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-uppercase fw-bold text-success small" style="font-size: 0.75rem;">Comprobante de Servicio Social</span>
                        <span class="badge bg-success-subtle text-success">Estado: Inscrito</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Carnet Estudiantil</small>
                            <strong class="fs-6 text-dark">@carnet</strong>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Horas a Acreditar</small>
                            <strong class="fs-6 text-success">@(proyecto?.nHorasAcreditar ?? 0) Horas</strong>
                        </div>
                        <div class="col-12">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Causa Ambiental</small>
                            <span class="fw-semibold text-dark">@(proyecto?.sTitulo ?? "Proyecto Ambiental")</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Municipio</small>
                            <span class="small">@(proyecto?.sNombreMunicipio ?? "El Salvador")</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Punto de Encuentro</small>
                            <span class="text-success small fw-semibold">@(proyecto?.sPuntoVerde ?? "Módulo Comunitario")</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a asp-action="Index" class="btn btn-eco-primary btn-sm px-4 py-2">
                        <i class="fa-solid fa-house me-1"></i> Ir al Inicio
                    </a>
                    <a asp-action="MisHoras" class="btn btn-outline-secondary btn-sm px-4 py-2">
                        <i class="fa-solid fa-award me-1"></i> Mis Horas Sociales
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
