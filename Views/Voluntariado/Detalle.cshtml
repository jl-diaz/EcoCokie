@model VoluntariadoAmbiental.Models.Proyecto
@{
    ViewData["Title"] = Model.sTitulo;
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-success text-decoration-none">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-success text-decoration-none">Convocatorias</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.sTitulo</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-8">
            <div class="bg-white rounded-3 border overflow-hidden shadow-sm mb-4">
                <img src="@(string.IsNullOrEmpty(Model.sImagenUrl) ? "https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=1200&q=80" : Model.sImagenUrl)" 
                     alt="@Model.sTitulo" class="w-100" style="max-height: 400px; object-fit: cover;" />
                
                <div class="p-4 p-md-5">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                            @Model.sCategoria
                        </span>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            @Model.nHorasAcreditar Horas Sociales
                        </span>
                        <span class="badge @(Model.sEstado == "Activo" ? "bg-success text-white" : "bg-secondary text-white") px-3 py-2 rounded-pill">
                            @Model.sEstado
                        </span>
                    </div>

                    <h2 class="fw-bold mb-4" style="color: var(--color-forest);">@Model.sTitulo</h2>

                    <h5 class="fw-bold text-dark mb-2">Descripción de la Actividad:</h5>
                    <p class="text-secondary lead fs-6 mb-4" style="white-space: pre-line; line-height: 1.8;">
                        @Model.sDescripcion
                    </p>

                    <!-- Punto Verde Comunitario -->
                    <div class="p-4 rounded-3 mb-4" style="background: var(--color-emerald-surface); border: 1px solid var(--color-emerald-border);">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="eco-brand-badge" style="width: 40px; height: 40px;">
                                <i class="fa-solid fa-recycle"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-success">Punto Verde / Lugar de Encuentro</h5>
                                <small class="text-muted">Registro de asistencia y entrega de insumos</small>
                            </div>
                        </div>
                        <p class="mb-1 fw-semibold text-dark fs-6 mt-3">
                            <i class="fa-solid fa-location-dot text-success me-2"></i>@(string.IsNullOrEmpty(Model.sPuntoVerde) ? "Módulo Ecológico Principal" : Model.sPuntoVerde)
                        </p>
                        <p class="small text-muted mb-0">
                            Punto oficial para control biométrico/asistencia de servicio social estudiantil.
                        </p>
                    </div>

                    <!-- Beneficios Estudiantiles -->
                    <div>
                        <h6 class="fw-bold text-dark text-uppercase small mb-3">Compromiso y Acreditación:</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-3 text-center border">
                                    <i class="fa-solid fa-certificate fa-2x text-success mb-2"></i>
                                    <h6 class="fw-bold mb-1 small">Constancia Oficial</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Válida para el expediente universitario.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-3 text-center border">
                                    <i class="fa-solid fa-shield-heart fa-2x text-primary mb-2"></i>
                                    <h6 class="fw-bold mb-1 small">Seguridad e Insumos</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Guantes, hidratación y transporte.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-3 text-center border">
                                    <i class="fa-solid fa-seedling fa-2x text-warning mb-2"></i>
                                    <h6 class="fw-bold mb-1 small">Impacto Ecológico</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Conservación real del ecosistema.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna de Logística -->
        <div class="col-lg-4">
            <div class="bg-white rounded-3 border p-4 shadow-sm eco-sticky-sidebar">
                <h5 class="fw-bold mb-4" style="color: var(--color-forest);">
                    Logística del Evento
                </h5>

                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="d-flex gap-3 align-items-start">
                        <i class="fa-regular fa-calendar-check text-success fs-5 mt-1"></i>
                        <div>
                            <span class="d-block text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Fecha Programada</span>
                            <strong class="text-dark">@Model.dFechaEvento.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start">
                        <i class="fa-solid fa-clock text-success fs-5 mt-1"></i>
                        <div>
                            <span class="d-block text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Horas Acreditables</span>
                            <span class="badge bg-success-subtle text-success fs-6">@Model.nHorasAcreditar Horas</span>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start">
                        <i class="fa-solid fa-location-dot text-danger fs-5 mt-1"></i>
                        <div>
                            <span class="d-block text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Municipio & Ubicación</span>
                            <strong class="text-dark">@Model.sNombreMunicipio, @Model.sDepartamento</strong>
                            <p class="text-muted small mb-0">@Model.sUbicacionDetallada</p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start">
                        <i class="fa-solid fa-building text-primary fs-5 mt-1"></i>
                        <div>
                            <span class="d-block text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Organizador</span>
                            <strong class="text-dark">@Model.sOrganizador</strong>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start">
                        <i class="fa-solid fa-users text-muted fs-5 mt-1"></i>
                        <div class="w-100">
                            <span class="d-block text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Disponibilidad de Cupos</span>
                            <strong class="fs-5 @(Model.nCuposDisponibles <= 5 ? "text-danger" : "text-success")">
                                @Model.nCuposDisponibles
                            </strong>
                            <span class="text-muted small">libres de @Model.nCuposTotales</span>
                        </div>
                    </div>
                </div>

                @if (Model.nCuposDisponibles > 0 && Model.sEstado != "Finalizado")
                {
                    if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Admin") || User.IsInRole("Organizacion"))
                        {
                            var rolNombre = User.IsInRole("Admin") ? "Administrador" : "Organización";
                            <div class="alert alert-warning small mb-0 py-2 text-center border-0">
                                <i class="fa-solid fa-shield-halved me-1"></i> Tu rol de <strong>@rolNombre</strong> es de gestión institucional y no permite postularse a actividades.
                            </div>
                        }
                        else
                        {
                            <a asp-action="Inscribir" asp-route-id="@Model.nIdProyecto" class="btn btn-eco-primary w-100 py-3">
                                <i class="fa-solid fa-user-plus me-1"></i> Inscribirme en la Convocatoria
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@Url.Action("Inscribir", "Voluntariado", new { id = Model.nIdProyecto })" class="btn btn-eco-primary w-100 py-3">
                            <i class="fa-solid fa-lock me-2"></i> Iniciar Sesión para Inscribirme
                        </a>
                        <small class="text-muted d-block text-center mt-2" style="font-size: 0.78rem;">
                            Debes ingresar con tu cuenta de estudiante para postularte.
                        </small>
                    }
                }
                else
                {
                    <button class="btn btn-secondary w-100 py-3" disabled>
                        Convocatoria Agotada
                    </button>
                }

                <div class="text-center mt-3">
                    <a asp-action="Index" class="text-muted small text-decoration-none">
                        <i class="fa-solid fa-arrow-left me-1"></i> Volver al catálogo
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
