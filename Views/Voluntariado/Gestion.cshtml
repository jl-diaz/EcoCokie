@model IEnumerable<VoluntariadoAmbiental.Models.Proyecto>
@{
    ViewData["Title"] = "Gestión de Convocatorias";
    var filtro = ViewBag.FiltroEstado as string;
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--color-forest);">
                Panel de Convocatorias Ambientales
            </h3>
            <p class="text-muted small mb-0">Publicación, edición de jornadas y seguimiento del estado de cada actividad.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Crear" class="btn btn-eco-primary">
                <i class="fa-solid fa-plus-circle me-1"></i> Publicar Convocatoria
            </a>
            <a asp-action="Asistencias" class="btn btn-outline-secondary">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> Validar Horas
            </a>
        </div>
    </div>

    <!-- Pestañas de Filtro -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="Gestion" class="btn btn-sm @(string.IsNullOrEmpty(filtro) ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3">
            Todas (@Model.Count())
        </a>
        <a asp-action="Gestion" asp-route-filtroEstado="Activo" class="btn btn-sm @(filtro == "Activo" ? "btn-success" : "btn-outline-secondary") rounded-pill px-3">
            Activas
        </a>
        <a asp-action="Gestion" asp-route-filtroEstado="Finalizado" class="btn btn-sm @(filtro == "Finalizado" ? "btn-secondary text-white" : "btn-outline-secondary") rounded-pill px-3">
            Finalizadas
        </a>
    </div>

    <div class="eco-table-wrapper">
        <div class="table-responsive">
            <table class="table eco-table">
                <thead>
                    <tr>
                        <th>Campaña & Categoría</th>
                        <th>Municipio</th>
                        <th>Fecha Evento</th>
                        <th>Horas</th>
                        <th>Cupos</th>
                        <th>Estado</th>
                        <th>Punto Verde</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted small">
                                No se encontraron convocatorias en el estado seleccionado.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong class="d-block text-dark">@item.sTitulo</strong>
                                <span class="badge bg-light text-success border">@item.sCategoria</span>
                            </td>
                            <td>
                                <div>@item.sNombreMunicipio</div>
                                <small class="text-muted">@item.sDepartamento</small>
                            </td>
                            <td>
                                @item.dFechaEvento.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <span class="fw-semibold text-success">@item.nHorasAcreditar hrs</span>
                            </td>
                            <td>
                                <small class="fw-semibold @(item.nCuposDisponibles <= 5 ? "text-danger" : "text-dark")">
                                    @item.nCuposDisponibles / @item.nCuposTotales
                                </small>
                            </td>
                            <td>
                                @if (item.sEstado == "Activo")
                                {
                                    <span class="eco-badge eco-badge-active">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="eco-badge eco-badge-finalized">
                                        Finalizado
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(string.IsNullOrEmpty(item.sPuntoVerde) ? "N/A" : item.sPuntoVerde)</small>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Asistencias" asp-route-idProyecto="@item.nIdProyecto" class="btn btn-sm btn-outline-secondary" title="Ver Voluntarios">
                                        <i class="fa-solid fa-users"></i>
                                    </a>

                                    <a asp-action="Editar" asp-route-id="@item.nIdProyecto" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    @if (item.sEstado == "Activo")
                                    {
                                        <form asp-action="Finalizar" asp-route-id="@item.nIdProyecto" method="post" class="d-inline" onsubmit="return confirm('¿Marcar esta actividad como finalizada?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning text-dark" title="Finalizar Actividad">
                                                <i class="fa-solid fa-flag-checkered"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Eliminar" asp-route-id="@item.nIdProyecto" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar definitivamente este registro?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Convocatoria">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
